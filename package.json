{
  "name": "drive-drive-car",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "playwright test",
    "format:check": "oxfmt --check .",
    "assets:vehicle": "node scripts/prepare-vehicle.mjs",
    "assets:environment": "node scripts/prepare-environment.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.187.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@webgpu/types": "0.1.74",
    "meshoptimizer": "1.3.0",
    "oxfmt": "0.78.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.18.0"
